{
  "name": "cursor-irl",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply cursor-irl --local",
    "db:migrate:remote": "wrangler d1 migrations apply cursor-irl --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.9.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@hono/zod-validator": "^0.7.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.118.0"
  }
}
