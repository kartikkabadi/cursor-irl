{
  "name": "cursor-irl",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:worker": "wrangler dev --local --persist-to .wrangler/state",
    "build": "tsc -b && vite build",
    "build:path": "tsc -b && VITE_BASE_PATH=/cursor-irl/ vite build && VITE_BASE_PATH=/cursor-irl/ VITE_FALLBACK_BUILD=1 vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply cursor-irl --local",
    "db:migrate:remote": "wrangler d1 migrations apply cursor-irl --remote",
    "deploy": "npm run build:path && wrangler deploy",
    "deploy:dry": "npm run build:path && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "@phosphor-icons/react": "^2.1.7",
    "framer-motion": "^12.23.12",
    "hono": "^4.9.8",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@tailwindcss/vite": "^4.1.12",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.103.0"
  }
}
